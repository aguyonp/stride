# ─── Stride : copier en .env et compléter. Ne jamais commiter .env. ───
# Le binaire lit .env (via ENV_FILE) sans écraser les variables déjà dans l'environnement.
# Les valeurs vides ci-dessous = valeur par défaut indiquée dans le commentaire.

# ── Obligatoire ──
# Clé maîtresse (32 octets base64) : chiffre les identifiants Garmin/Strava stockés.
# Générer : openssl rand -base64 32
STRIDE_MASTER_KEY=

# Clé précédente, uniquement pendant une rotation de STRIDE_MASTER_KEY.
STRIDE_MASTER_KEY_PREVIOUS=

# ── Réseau & stockage ──
# Adresse d'écoute HTTP (défaut :8080).
STRIDE_LISTEN_ADDR=
# Listener Prometheus /metrics séparé ; vide = désactivé (défaut, ex. :9090 — jamais à publier).
STRIDE_METRICS_ADDR=
# Répertoire de données (défaut ./data). Le fichier SQLite est STRIDE_DB_PATH (défaut <data>/stride.db).
STRIDE_DATA_DIR=
STRIDE_DB_PATH=
# Cache / pub-sub Valkey (défaut : vide = cache mémoire) ; compose.yml le pointe vers le conteneur valkey.
STRIDE_VALKEY_URL=

# ── URL publique & connexion ──
# URL publique de l'instance (défaut http://localhost:8080) ; le schéma https active les cookies Secure.
STRIDE_PUBLIC_URL=
# Mode d'inscription : invite (défaut) | open.
STRIDE_REGISTRATION=
# Durée de session (durée Go, défaut 720h = 30 jours).
STRIDE_SESSION_TTL=
# WebAuthn : RP ID (défaut : hostname de STRIDE_PUBLIC_URL) et origines autorisées, séparées par des virgules (défaut : STRIDE_PUBLIC_URL).
STRIDE_WEBAUTHN_RP_ID=
STRIDE_WEBAUTHN_ORIGINS=

# ── Fuseau & logs ──
# Fuseau horaire IANA de l'instance (défaut Europe/Paris).
TZ=
# Logs : LOG_LEVEL = debug|info|warn|error (défaut info) ; LOG_FORMAT = pretty|json (défaut pretty).
LOG_LEVEL=
LOG_FORMAT=
# Défini : logs sans couleurs ANSI (convention NO_COLOR).
NO_COLOR=

# ── Garmin ──
# Clé Garmin Personal API (Garmin Connect › Paramètres › API personnelle).
# Alias accepté : GARMIN_API_TOKEN. Peut aussi être saisie dans l'UI (prioritaire, stockée chiffrée dans la base).
STRIDE_ADMIN_GARMIN_KEY=
GARMIN_API_TOKEN=
# Périphérique : URL de la Personal API (défaut https://personal.connectapi.garmin.com).
STRIDE_GARMIN_BASE_URL=
# Heure (0-23) de la synchronisation quotidienne (défaut 7), décalée entre STRIDE_SYNC_JITTER_MIN (défaut 30s) et STRIDE_SYNC_JITTER_MAX (défaut 90s).
STRIDE_SYNC_HOUR=
STRIDE_SYNC_JITTER_MIN=
STRIDE_SYNC_JITTER_MAX=

# ── Strava (optionnel) ──
# Application OAuth2 : les deux variables activent la synchronisation Strava.
STRIDE_STRAVA_CLIENT_ID=
STRIDE_STRAVA_CLIENT_SECRET=
# Jeton qui valide le webhook /api/strava/webhook.
STRIDE_STRAVA_WEBHOOK_TOKEN=
# Graine one-time de la connexion Strava du premier administrateur (les jetons rafraîchis vivent ensuite en base).
STRIDE_STRAVA_ACCESS_TOKEN=
STRIDE_STRAVA_REFRESH_TOKEN=

# ── Météo (optionnel) ──
# Fournisseur (défaut open-meteo).
STRIDE_WEATHER=

# ── Egress (optionnel) ──
# Autoriser les URLs saisies par les utilisateurs (base URL LLM, webhooks) d'atteindre le réseau privé.
STRIDE_ALLOW_PRIVATE_EGRESS=

# ── Sauvegarde S3 (optionnel, graine one-time des réglages admin) ──
# Seedée une fois dans les réglages admin si aucune cible n'y est configurée ; vide = rien à semer.
STRIDE_S3_ENDPOINT=
STRIDE_S3_REGION=
STRIDE_S3_BUCKET=
STRIDE_S3_PREFIX=
STRIDE_S3_ACCESS_KEY_ID=
STRIDE_S3_SECRET_ACCESS_KEY=
STRIDE_S3_PATH_STYLE=
STRIDE_S3_AUTO_UPLOAD=
STRIDE_S3_RETENTION_DAYS=

# ── Divers ──
# Chemin du fichier .env (défaut ./.env, relatif au répertoire de travail du binaire).
ENV_FILE=

# ── docker-compose (lus par compose.yml, pas par le binaire) ──
# Interface/port exposés sur l'hôte (défauts 127.0.0.1:8080) et tag d'image (défaut latest).
STRIDE_HOST_BIND=
STRIDE_HOST_PORT=
STRIDE_TAG=
# docker-compose (Linux) : UID/GID propriétaires de ./data (défaut 65532 = nonroot distroless).
STRIDE_UID=
STRIDE_GID=
