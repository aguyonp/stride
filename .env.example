# ─── Stride : copier en .env et compléter. Ne jamais commiter .env. ───

# Clé Garmin Personal API (Garmin Connect › Paramètres › API personnelle).
# Alias acceptés : GARMIN_PERSONAL_API_KEY, GARMIN_API_KEY.
# Peut aussi être saisie dans l'UI (prioritaire, stockée dans data/settings.json en 0600).
GARMIN_API_TOKEN=

# Authentification HTTP Basic optionnelle (tout sauf /api/health). Recommandée hors localhost.
APP_AUTH_USER=
APP_AUTH_PASSWORD=

# Fuseau horaire de l'application (défaut : Europe/Paris ; TZ est aussi lu).
APP_TIMEZONE=

# Logs : LOG_LEVEL = debug|info|warn|error (défaut info) ; LOG_FORMAT = pretty|json (défaut pretty).
LOG_LEVEL=
LOG_FORMAT=

# Hors Docker uniquement : port HTTP (défaut 8080) et répertoire de données (défaut ./data).
# (docker-compose force PORT=8080 et DATA_DIR=/data dans le conteneur)
PORT=
DATA_DIR=

# docker-compose : interface/port exposés sur l'hôte (défaut 127.0.0.1:8080), version d'image.
STRIDE_BIND=
STRIDE_PORT=
STRIDE_VERSION=

# docker-compose (Linux) : UID/GID propriétaires de ./data (défaut 65532 = nonroot distroless).
STRIDE_UID=
STRIDE_GID=
