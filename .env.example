# ─── Stride: copy to .env and fill in. Never commit .env. ───
# The binary reads .env (via ENV_FILE) without overriding variables already set in the environment.
# Empty values below = the default stated in the comment.

# ── Required ──
# Master key (32 bytes base64): encrypts the stored Garmin/Strava credentials.
# Generate: openssl rand -base64 32
STRIDE_MASTER_KEY=

# Previous key, only during a STRIDE_MASTER_KEY rotation.
STRIDE_MASTER_KEY_PREVIOUS=

# ── Network & storage ──
# HTTP listen address (default :8080).
STRIDE_LISTEN_ADDR=
# Separate Prometheus /metrics listener; empty = disabled (default, e.g. :9090 — never publish it).
STRIDE_METRICS_ADDR=
# Data directory (default ./data). The SQLite file is STRIDE_DB_PATH (default <data>/stride.db).
STRIDE_DATA_DIR=
STRIDE_DB_PATH=
# Valkey cache / pub-sub (default: empty = in-memory cache); compose.yml points it at the valkey container.
STRIDE_VALKEY_URL=

# ── Public URL & auth ──
# Public URL of the instance (default http://localhost:8080); the https scheme enables Secure cookies.
STRIDE_PUBLIC_URL=
# Registration mode: invite (default) | open.
STRIDE_REGISTRATION=
# Session lifetime (Go duration, default 720h = 30 days).
STRIDE_SESSION_TTL=
# WebAuthn: RP ID (default: hostname of STRIDE_PUBLIC_URL) and allowed origins, comma-separated (default: STRIDE_PUBLIC_URL).
STRIDE_WEBAUTHN_RP_ID=
STRIDE_WEBAUTHN_ORIGINS=

# ── Timezone & logs ──
# IANA timezone of the instance (default Europe/Paris).
TZ=
# Logs: LOG_LEVEL = debug|info|warn|error (default info); LOG_FORMAT = pretty|json (default pretty).
LOG_LEVEL=
LOG_FORMAT=
# Set: logs without ANSI colors (NO_COLOR convention).
NO_COLOR=

# ── Garmin ──
# Garmin Personal API key (Garmin Connect › Settings › Personal API).
# Accepted alias: GARMIN_API_TOKEN. Can also be entered in the UI (takes precedence, stored encrypted in the DB).
STRIDE_ADMIN_GARMIN_KEY=
GARMIN_API_TOKEN=
# Device: Personal API URL (default https://personal.connectapi.garmin.com).
STRIDE_GARMIN_BASE_URL=
# Hour (0-23) of the daily sync (default 7), jittered between STRIDE_SYNC_JITTER_MIN (default 30s) and STRIDE_SYNC_JITTER_MAX (default 90s).
STRIDE_SYNC_HOUR=
STRIDE_SYNC_JITTER_MIN=
STRIDE_SYNC_JITTER_MAX=

# ── Strava (optional) ──
# OAuth2 app: these two variables enable Strava sync.
STRIDE_STRAVA_CLIENT_ID=
STRIDE_STRAVA_CLIENT_SECRET=
# Token that validates the /api/strava/webhook webhook.
STRIDE_STRAVA_WEBHOOK_TOKEN=
# One-time seed for the first administrator's Strava connection (refreshed tokens then live in the DB).
STRIDE_STRAVA_ACCESS_TOKEN=
STRIDE_STRAVA_REFRESH_TOKEN=

# ── Weather (optional) ──
# Provider (default open-meteo).
STRIDE_WEATHER=

# ── Egress (optional) ──
# Allow user-supplied URLs (LLM base URL, webhooks) to reach the private network.
STRIDE_ALLOW_PRIVATE_EGRESS=

# ── Experimental Garmin Connect bridge (optional, off by default) ──
# Master switch of the workout push through Garmin's *web* API (unofficial, risk of account
# suspension). The admin setting garminBridgeEnabled must also be on. false = no client, no route.
# Without it, the .FIT import (download + Garmin Connect Web) is the only way to the watch.
STRIDE_GARMIN_BRIDGE=

# ── S3 backup (optional, one-time seed of the admin settings) ──
# Seeded once into the admin settings if no target is configured there; empty = nothing to seed.
STRIDE_S3_ENDPOINT=
STRIDE_S3_REGION=
STRIDE_S3_BUCKET=
STRIDE_S3_PREFIX=
STRIDE_S3_ACCESS_KEY_ID=
STRIDE_S3_SECRET_ACCESS_KEY=
STRIDE_S3_PATH_STYLE=
STRIDE_S3_AUTO_UPLOAD=
STRIDE_S3_RETENTION_DAYS=

# ── Misc ──
# Path of the .env file (default ./.env, relative to the binary's working directory).
ENV_FILE=

# ── docker-compose (read by compose.yml, not by the binary) ──
# Host interface/port exposed (defaults 127.0.0.1:8080) and image tag (default latest).
STRIDE_HOST_BIND=
STRIDE_HOST_PORT=
STRIDE_TAG=
# docker-compose (Linux): UID/GID that own ./data (default 65532 = distroless nonroot).
STRIDE_UID=
STRIDE_GID=
